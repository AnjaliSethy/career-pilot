NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Single-owner mode: set to false after you create your account
ALLOW_REGISTRATION=true

# Get a key at https://aistudio.google.com/apikey (backend only, never in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
